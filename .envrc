use flake

export RUST_BACKTRACE=1
export LAZYSYNC_LOG="${LAZYSYNC_LOG:-lazysync=debug}"

# Point the dev build at a scratch config tree rather than your real one.
# Without this, running `cargo run` while hacking on the bookmark store edits
# the bookmarks you actually use.
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export LAZYSYNC_DEV_CONFIG_DIR="$PWD/.dev/config"
export LAZYSYNC_DEV_STATE_DIR="$PWD/.dev/state"

if [ -f .envrc.local ]; then
    source .envrc.local
fi
